{"title": "Nǐ hǎo, wǒ shì ā lì", "title_fa": "سلام، من علی هستم", "lines": [{"who": "N", "t": "早上好。今天是一个好天气。", "fa": "صبح بخیر. امروز هوا خوب است."}, {"who": "A", "t": "你好！", "fa": "سلام!"}, {"who": "B", "t": "你好！你叫什么名字？", "fa": "سلام! اسم شما چیست؟"}, {"who": "A", "t": "我叫法蒂玛。你呢？", "fa": "من فاطمه هستم. شما چطور؟"}, {"who": "B", "t": "我叫阿里。我是伊朗人。", "fa": "من علی هستم. من ایرانی هستم."}, {"who": "A", "t": "真的吗？我是中国人。", "fa": "راست میگی؟ من چینی هستم."}, {"who": "B", "t": "太好了！很高兴认识你。", "fa": "خیلی عالیه! از آشنایی با شما خوشحالم."}, {"who": "A", "t": "谢谢你。", "fa": "از شما ممنونم."}, {"who": "B", "t": "不客气。", "fa": "خواهش می‌کنم."}, {"who": "A", "t": "对不起，我要走了。", "fa": "ببخشید، من باید بروم."}, {"who": "B", "t": "没关系。明天见！", "fa": "اشکالی ندارد. فردا می‌بینمت!"}, {"who": "A", "t": "再见！", "fa": "خداحافظ!"}], "words": [{"w": "你好 (nǐ hǎo)", "fa": "سلام"}, {"w": "谢谢 (xièxie)", "fa": "ممنون، تشکر"}, {"w": "不客气 (bú kèqi)", "fa": "خواهش می‌کنم"}, {"w": "对不起 (duìbuqǐ)", "fa": "ببخشید"}, {"w": "我叫… (wǒ jiào…)", "fa": "من نام دارم..."}, {"w": "是 (shì)", "fa": "هست، بودن"}, {"w": "伊朗人 (Yīlángrén)", "fa": "ایرانی"}, {"w": "中国人 (Zhōngguórén)", "fa": "چینی"}], "quiz": [{"q": "بسر (علی) اهل کدام کشور است؟", "opts": ["چین", "ایران", "آمریکا"], "a": 1}, {"q": "نام دختر چیست؟", "opts": ["فاطمه", "مریم", "زهرا"], "a": 0}, {"q": "علی در جواب تشکر فاطمه چه گفت؟", "opts": ["خداحافظ", "ببخشید", "خواهش می‌کنم"], "a": 2}]}