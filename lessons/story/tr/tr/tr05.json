{"title": "Yeni Evimiz ve Mahallemiz", "title_fa": "خانه جدید و محله ما", "lines": [{"who": "N", "t": "Ali ve Ayşe yeni bir apartmanda.", "fa": "علی و عایشه در یک آپارتمان جدید هستند."}, {"who": "A", "t": "Ali, mutfak nerede?", "fa": "علی، آشپزخانه کجاست؟"}, {"who": "B", "t": "Mutfak burada, salonun yanında.", "fa": "آشپزخانه اینجاست، کنار سالن است."}, {"who": "A", "t": "Buzdolabı var mı?", "fa": "یخچال وجود دارد؟ (یخچال هست؟)"}, {"who": "B", "t": "Evet, buzdolabı var ama fırın yok.", "fa": "بله، یخچال هست اما فر وجود ندارد."}, {"who": "N", "t": "Ayşe balkona bakıyor.", "fa": "عایشه به بالکن نگاه می‌کند."}, {"who": "A", "t": "Bak, bahçede bir kedi var!", "fa": "نگاه کن، در باغچه یک گربه هست!"}, {"who": "B", "t": "Mahalle çok güzel. Sokakta okul ve market var.", "fa": "محله خیلی زیباست. در خیابان مدرسه و مارکت هست."}, {"who": "A", "t": "Eczane nerede?", "fa": "داروخانه کجاست؟"}, {"who": "B", "t": "Eczane caddede, parkın önünde.", "fa": "داروخانه در خیابان اصلی است، جلوی پارک."}, {"who": "N", "t": "Onlar yeni evlerini seviyor.", "fa": "آنها خانه جدیدشان را دوست دارند."}, {"who": "A", "t": "Yatak odası çok rahat.", "fa": "اتاق خواب خیلی راحت است."}, {"who": "B", "t": "Evet, dolabın içinde büyük bir halı var.", "fa": "بله، داخل کمد یک فرش بزرگ هست."}], "words": [{"w": "Mutfak", "fa": "آشپزخانه"}, {"w": "Buzdolabı", "fa": "یخچال"}, {"w": "Mahalle", "fa": "محله"}, {"w": "Sokak", "fa": "کوچه/خیابان فرعی"}, {"w": "Cadde", "fa": "خیابان اصلی"}, {"w": "Eczane", "fa": "داروخانه"}, {"w": "Bahçe", "fa": "باغچه/حیاط"}, {"w": "Oda", "fa": "اتاق"}], "quiz": [{"q": "Evde hangisi yok?", "opts": ["Buzdolabı", "Fırın", "Oda"], "a": 1}, {"q": "Eczane nerede?", "opts": ["Parkın yanında", "Parkın önünde", "Okulun içinde"], "a": 1}, {"q": "Bahçede ne var?", "opts": ["Bir köpek", "Bir kedi", "Bir masa"], "a": 1}]}