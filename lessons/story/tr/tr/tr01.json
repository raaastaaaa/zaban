{"title": "Derya ve Kardeşi Ali", "title_fa": "دریا و برادرش علی", "lines": [{"who": "N", "t": "Derya masada oturuyor. Hava güzel.", "fa": "دریا پشت میز نشسته. هوا خوبه."}, {"who": "A", "t": "Merhaba Ali! Nasılsın?", "fa": "سلام علی! چطوری؟"}, {"who": "B", "t": "İyiyim Derya. Çay içiyorum.", "fa": "خوبم دریا. دارم چای می‌خورم."}, {"who": "N", "t": "Ali, defter ve kalem istiyor.", "fa": "علی دفتر و مداد می‌خواد."}, {"who": "B", "t": "Pencere açık. Çok soğuk!", "fa": "پنجره بازه. خیلی سرده!"}, {"who": "A", "t": "Kalın bir kitap mı okuyorsun?", "fa": "داری یه کتاب کلفت می‌خونی؟"}, {"who": "B", "t": "Evet, sözlük okuyorum. Kök ve ek öğreniyorum.", "fa": "آره، دارم لغت‌نامه می‌خونم. ریشه و پسوند یاد می‌گیرم."}, {"who": "N", "t": "Vowel harmony (ünlü uyumu) çok önemli.", "fa": "هماهنگی صوتی خیلی مهمه."}, {"who": "A", "t": "Sen çalışkan bir kardeşsin.", "fa": "تو برادر سخت‌کوشی هستی."}, {"who": "B", "t": "Siz de çok iyisiniz.", "fa": "شما هم خیلی خوب هستید."}, {"who": "N", "t": "Kardeşler çanta ve kağıt alıyor.", "fa": "خواهر و برادر کیف و کاغذ برمی‌دارند."}, {"who": "A", "t": "Haydi, kalem ve silgi burada!", "fa": "بزن بریم، مداد و پاک‌کن اینجاست!"}, {"who": "B", "t": "Görüşürüz!", "fa": "می‌بینمت!"}], "words": [{"w": "Çay", "fa": "چای"}, {"w": "Pencere", "fa": "پنجره"}, {"w": "Kardeş", "fa": "خواهر یا برادر"}, {"w": "Sözlük", "fa": "لغت‌نامه"}, {"w": "Kalın", "fa": "کلفت/ضخیم"}, {"w": "İnce", "fa": "نازک"}, {"w": "Kök", "fa": "ریشه"}, {"w": "Ek", "fa": "پسوند"}], "quiz": [{"q": "علی چه چیزی می‌خورد؟", "opts": ["قهوه", "چای", "آب"], "a": 1}, {"q": "هوا چطور است؟", "opts": ["سرد", "گرم", "بارانی"], "a": 0}, {"q": "علی چه چیزی مطالعه می‌کند؟", "opts": ["روزنامه", "کتاب داستان", "لغت‌نامه"], "a": 2}]}